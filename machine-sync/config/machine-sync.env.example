# machine-sync user config (Mac side).
# Copy to ~/.machine-sync.env and edit. Not read from the repo.

# ssh alias for the PC, defined in ~/.ssh/config
PEER_HOST=pc

# PC-side base for relative peer paths. Forward slashes, drive-letter form.
PEER_ROOT=C:/Users/ians0/Documents/mf

# Mac-side base for relative local paths.
LOCAL_ROOT=$HOME/Desktop/MAINFRAME

# Where pull.pc.claude lands files and push.pc.claude reads from.
CLAUDE_DIR=$HOME/claude/session/working
