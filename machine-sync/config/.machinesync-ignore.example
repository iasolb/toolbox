# machine-sync ignore patterns, one per line, passed to tar --exclude.
# Personal copy goes at ~/.machinesync-ignore (falls back to this file).
# Regenerable/derived stuff only. Never .git: a synced repo stays a real repo.
.venv
venv
node_modules
__pycache__
*.pyc
.ipynb_checkpoints
.pytest_cache
.mypy_cache
.ruff_cache
.DS_Store
