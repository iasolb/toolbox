# machine-sync user config (Windows side).
# Copy to $HOME\.machine-sync.ps1 and edit. Not read from the repo.

# ssh alias for the Mac, defined in $HOME\.ssh\config
$PeerHost = 'mac'

# Mac-side base for relative peer paths. Absolute (/Users/...) or relative
# to the Mac home dir.
$PeerRoot = 'Desktop/MAINFRAME'

# PC-side base for relative local paths.
$LocalRoot = 'C:\Users\ians0\Documents\mf'

# Where pull.mac.claude lands files and push.mac.claude reads from.
$ClaudeDir = 'C:\Users\ians0\claude\session\working'
