#!/usr/bin/env bash
set -u -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/common.sh"
load_config

usage() {
    echo 'Usage: pull.pc --from <pc path> --to <mac path> [--csv]'
    echo "  --from resolves against the PC root ($PEER_ROOT) unless it starts with a drive letter."
    echo "  --to is the Mac parent directory, resolved against $LOCAL_ROOT unless absolute."
    echo '  The pulled item lands at <to>/<leaf>. Existing same-name files are overwritten.'
    echo '  --csv runs transferred .csv files through the UTF-8 ensurer afterwards.'
}

FROM=''
TO=''
CSV=0

while [ $# -gt 0 ]; do
    case "$1" in
        --from)
            shift
            [ $# -gt 0 ] || die 'Missing value after --from'
            FROM="$1"
            ;;
        --to)
            shift
            [ $# -gt 0 ] || die 'Missing value after --to'
            TO="$1"
            ;;
        --csv) CSV=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unexpected argument: $1" ;;
    esac
    shift
done

if [ -z "$FROM" ]; then
    echo 'pull.pc requires --from <pc path>. Nothing was pulled.' >&2
    usage
    exit 1
fi
if [ -z "$TO" ]; then
    echo 'pull.pc requires --to <mac path>. Nothing was pulled.' >&2
    usage
    exit 1
fi

machine_sync_pull 'pull.pc' "$FROM" "$(resolve_local_path "$LOCAL_ROOT" "$TO")" "$CSV"
