#!/usr/bin/env bash
set -u -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/common.sh"
load_config

usage() {
    echo 'Usage: push.pc.claude <path> --to <pc path> [--csv]'
    echo "  <path> resolves against the claude working dir ($CLAUDE_DIR) unless absolute."
    echo "  --to is the PC parent directory, resolved against $PEER_ROOT unless it starts with a drive letter."
    echo '  The pushed item lands at <to>/<leaf> on the PC. Existing destination requires a y/N confirm.'
    echo '  --csv runs transferred .csv files through the UTF-8 ensurer on the PC afterwards.'
}

PATH_ARG=''
TO=''
CSV=0

while [ $# -gt 0 ]; do
    case "$1" in
        --to)
            shift
            [ $# -gt 0 ] || die 'Missing value after --to'
            TO="$1"
            ;;
        --csv) CSV=1 ;;
        -h|--help) usage; exit 0 ;;
        *)
            [ -z "$PATH_ARG" ] || die 'push.pc.claude takes exactly one path argument.'
            PATH_ARG="$1"
            ;;
    esac
    shift
done

if [ -z "$PATH_ARG" ]; then
    usage
    exit 1
fi
if [ -z "$TO" ]; then
    echo 'push.pc.claude requires --to <pc path>. Nothing was pushed.' >&2
    usage
    exit 1
fi

machine_sync_push 'push.pc.claude' "$CLAUDE_DIR" "$PATH_ARG" "$TO" "$CSV"
