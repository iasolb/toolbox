#!/usr/bin/env bash
set -u -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/common.sh"
load_config

usage() {
    echo 'Usage: push.pc --from <mac path> --to <pc path> [--csv]'
    echo "  --from resolves against $LOCAL_ROOT unless absolute."
    echo "  --to is the PC parent directory, resolved against $PEER_ROOT unless it starts with a drive letter."
    echo '  The pushed item lands at <to>/<leaf> on the PC. Existing destination requires a y/N confirm.'
    echo '  --csv runs transferred .csv files through the UTF-8 ensurer on the PC afterwards.'
}

FROM=''
TO=''
CSV=0

while [ $# -gt 0 ]; do
    case "$1" in
        --from)
            shift
            [ $# -gt 0 ] || die 'Missing value after --from'
            FROM="$1"
            ;;
        --to)
            shift
            [ $# -gt 0 ] || die 'Missing value after --to'
            TO="$1"
            ;;
        --csv) CSV=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unexpected argument: $1" ;;
    esac
    shift
done

if [ -z "$FROM" ]; then
    echo 'push.pc requires --from <mac path>. Nothing was pushed.' >&2
    usage
    exit 1
fi
if [ -z "$TO" ]; then
    echo 'push.pc requires --to <pc path>. Nothing was pushed.' >&2
    usage
    exit 1
fi

machine_sync_push 'push.pc' "$LOCAL_ROOT" "$FROM" "$TO" "$CSV"
